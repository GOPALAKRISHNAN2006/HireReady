PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/hireready

# Authentication
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=7

# Default Admin Credentials (For initial bootstrap)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password_here

# AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Client Application URL
FRONTEND_URL=http://localhost:5173

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Email Delivery (Brevo or SMTP)
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=noreply@example.com

# SMTP Fallback (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_username_here
SMTP_PASS=smtp_password_here
